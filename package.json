{
  "name": "char-counter",
  "displayName": "Character Counter",
  "description": "Count characters inside <counter> tags and add separators when reaching goal",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.107.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:char-counter.countCharacters",
    "onLanguage:plaintext",
    "onLanguage:markdown",
    "onLanguage:html"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Character Counter",
      "properties": {
        "charCounter.goalNums": {
          "type": "number",
          "default": 200,
          "description": "Number of characters to trigger the separator line"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}