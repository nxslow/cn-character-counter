{
  "name": "char-counter",
  "displayName": "Character Counter",
  "description": "实时显示字符数量并在达到目标倍数时添加分隔线",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.107.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:char-counter.countCharacters",
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "char-counter.countCharacters",
        "title": "Character Counter: Count Characters"
      }
    ],
    "configuration": {
      "title": "Character Counter",
      "properties": {
        "charCounter.goalNums": {
          "type": "number",
          "default": 10,
          "description": "触发分隔线的字符基数（达到正整数倍时添加分隔线）"
        },
        "charCounter.enableSeparator": {
          "type": "boolean",
          "default": false,
          "description": "是否启用分隔线功能"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}